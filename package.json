{
  "name": "pdf-translator-desktop",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "b": "pnpm build",
    "typecheck": "tsc --noEmit && pnpm --dir packages/document-model typecheck && pnpm --dir packages/pdf-parser typecheck && pnpm --dir packages/layout-engine typecheck && pnpm --dir packages/docx-engine typecheck && pnpm --dir packages/translation-engine typecheck && pnpm --dir packages/document-pipeline typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:release-secrets": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/check-release-secrets.ps1",
    "write:release-checksums": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/write-release-checksums.ps1",
    "stage:libreoffice": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stage-libreoffice.ps1",
    "stage:python": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stage-python.ps1",
    "stage:runtimes": "pnpm stage:libreoffice && pnpm stage:python",
    "build:inno": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-inno-installer.ps1",
    "verify:installed-runtime": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-installed-runtime.ps1",
    "release:inno": "pnpm stage:runtimes && pnpm tauri build && pnpm build:inno && pnpm write:release-checksums",
    "tauri:portable": "pnpm stage:runtimes && pnpm tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@pdf-translator/document-model": "workspace:*",
    "@pdf-translator/document-pipeline": "workspace:*",
    "@pdf-translator/docx-engine": "workspace:*",
    "@pdf-translator/layout-engine": "workspace:*",
    "@pdf-translator/pdf-parser": "workspace:*",
    "@pdf-translator/translation-engine": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "docx": "^9.5.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^8.0.16",
    "vitest": "^4.0.18"
  }
}
