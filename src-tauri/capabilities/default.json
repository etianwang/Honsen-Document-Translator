{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "opener:default",
    "dialog:default",
    "fs:allow-read-file",
    {
      "identifier": "fs:scope",
      "allow": ["$TEMP/honsen-preview-*/**"]
    },
    "fs:allow-write-file"
  ]
}
