{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Honsen PDF Translator",
  "version": "1.0.1",
  "identifier": "com.pdftranslator.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Honsen PDF Translator",
        "width": 1480,
        "height": 800,
        "minWidth": 1480,
        "minHeight": 700,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "../logo.ico"
    ],
    "resources": ["resources/tessdata/*", "resources/bin/tesseract/*", "resources/bin/poppler/*", "resources/libreoffice/"],
    "windows": {
      "wix": { "language": "zh-CN" },
      "nsis": { "languages": ["SimpChinese"] }
    }
  }
}
